---
import { EyeClosedIcon, Eye } from '@lucide/astro';
const { blok } = Astro.props;
---
<div class="mb-4" x-data="{ showPassword: false }">
  {blok.name === 'password' ? (
    <div class="relative">
      <input
        x-model="password"
        :type="showPassword ? 'text' : 'password'"
        name={blok.name}
        placeholder={blok.placeholder || 'Password'}
        required={blok.required === "true"}
        class="w-full px-4 py-2 border border-gray-300 rounded-md pr-10 focus:outline-none focus:ring-2 focus:ring-purple-500"
      />
      
      <!-- Eye icon (when password is hidden) -->
      <button
        type="button"
        @click="showPassword = true"
        x-show="!showPassword"
        class="absolute right-3 top-1/2 transform -translate-y-1/2"
      >
        <Eye class="w-5 h-5 text-gray-500" />
      </button>

      <!-- EyeClosed icon (when password is visible) -->
      <button
        type="button"
        @click="showPassword = false"
        x-show="showPassword"
        class="absolute right-3 top-1/2 transform -translate-y-1/2"
      >
        <EyeClosedIcon class="w-5 h-5 text-gray-500" />
      </button>
    </div>
  ) : (
    <input
      type={blok.type?.[0] || "text"}
      name={blok.name}
      placeholder={blok.placeholder}
      required={blok.required === "true"}
      class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"
      x-model={`${blok.name}`}
    />
  )}
</div>
