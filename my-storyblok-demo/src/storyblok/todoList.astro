---
import { Trash2, Edit } from '@lucide/astro';
const { blok } = Astro.props;
---

<ul class="space-y-2 max-h-[300px] overflow-y-auto">
  <template x-if="filteredTodos.length === 0">
    <div class="text-center py-8 text-gray-500">
      <p>{blok.default_message}</p>
    </div>
  </template>

  <template x-for="todo in filteredTodos" :key="todo.id || todo.id || todo.text">
    <li
      class="bg-white shadow p-4 rounded flex justify-between items-center">
      <!-- x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
    > -->
      <div class="flex items-center space-x-2">
        <input
          type="checkbox"
          :checked="todo.completed"
          @change.prevent="toggleTodo(todo.id)"
          class="form-checkbox"
        />

        <template x-if="editingId === todo.id">
          <input
            x-model="todo.text"
            @keyup.enter.prevent="saveEdit(todo)"
            class="border px-2 py-1 rounded text-sm"
          />
        </template>

        <template x-if="editingId !== todo.id">
          <span
            x-text="todo.text"
            :class="{ 'line-through text-gray-400': todo.completed }"
          ></span>
        </template>
      </div>

      <div class="flex items-center space-x-2">
        <button
          type="button"
          @click.prevent="editingId = todo.id"
          class="text-purple-600 hover:text-purple-800"
          aria-label="Edit task"
        >
          <Edit class="w-5 h-5" />
        </button>

        <button
          type="button"
          @click.prevent="deleteTodo(todo.id)"
          class="text-red-500 hover:text-red-700"
          aria-label="Delete task"
        >
          <Trash2 class="w-5 h-5" />
        </button>
      </div>
    </li>
  </template>
</ul>
