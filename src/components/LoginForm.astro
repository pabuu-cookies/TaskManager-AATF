---
import { EyeClosedIcon, Eye } from '@lucide/astro';
---

<div x-data="{
    email: '',
    password: '',
    showPassword: false,
    submitLogin() {
      console.log('Logging in:', this.email, this.password);
      fetch('/api/auth/signin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: this.email, password: this.password })
      })
      .then(res => res.json())
      .then(data => {
        console.log('Login success:', data);
        if (data.success) {
          localStorage.setItem('user', JSON.stringify(data.data));
          window.location.href = '/dashboard';
        } else {
          throw new Error('Login failed');
        }
      })
      .catch(err => console.error('Login error:', err));
    }
  }">
  <form class="space-y-4" @submit.prevent="submitLogin">
    <h2 class="text-2xl font-bold text-gray-900">Log In</h2>
    
    <input
      x-model="email"
      type="email"
      placeholder="Email"
      class="w-full px-4 py-2 border rounded"
    />

    <!-- Relative container to hold input and icon -->
    <div class="relative">
      <input
        x-model="password"
        :type="showPassword ? 'text' : 'password'"
        placeholder="Password"
        class="w-full px-4 py-2 border rounded pr-10"
      />
      <!-- Eye icon (when password is hidden) -->
      <Eye
        x-show="!showPassword"
        @click="showPassword = true"
        class="absolute right-3 top-1/2 transform -translate-y-1/2"
      />

      <!-- EyeClosed icon (when password is visible) -->
      <EyeClosedIcon
        x-show="showPassword"
        @click="showPassword = false"
        class="absolute right-3 top-1/2 transform -translate-y-1/2"
      />
    </div>

    <button
      type="submit"
      class="w-full px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700"
    >
      Log In
    </button>
  </form>
</div>
