<div x-data="{
    name: '', email: '', password: '',
    submitSignup() {
      console.log('Signing up:', this.name, this.email, this.password);
      fetch('/api/auth/signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: this.name, email: this.email, password: this.password })
      })
      .then(res => res.json())
      .then(data => console.log('Signup success:', data))
      .catch(err => console.error('Signup error:', err));
    }
  }">
    <form class="space-y-4" @submit.prevent="submitSignup">
      <h2 class="text-2xl font-bold text-gray-800">Sign Up</h2>
      <input x-model="name" type="text" placeholder="Name" class="w-full px-4 py-2 border rounded" />
      <input x-model="email" type="email" placeholder="Email" class="w-full px-4 py-2 border rounded" />
      <input x-model="password" type="password" placeholder="Password" class="w-full px-4 py-2 border rounded" />
      <button type="submit" class="w-full px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700">Sign Up</button>
    </form>
  </div>
  