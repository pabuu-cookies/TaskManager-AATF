---
import '../styles/global.css'
const { title = "TaskMate" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  </head>
  <body class="bg-purple-500 min-h-screen p-4 overflow-y-hidden ">
    <slot />
  </body>
</html>
