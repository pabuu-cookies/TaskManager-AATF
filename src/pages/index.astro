---
import BaseLayout from "../layouts/baseLayout.astro";
---
<BaseLayout title="TaskMate - Dashboard">
  <div
    x-data="todoDashboard"
    x-init="fetchTodos()"
    class="min-h-screen bg-gradient-to-br from-purple-50 to-blue-50"
  >
    <header class="p-4 flex justify-between items-center">
      <h1 class="text-xl font-bold">TaskMate</h1>
      <button @click="logout" class="text-sm text-red-500 hover:underline">Logout</button>
    </header>

    <main class="container mx-auto px-4 py-8 max-w-3xl">
      <div class="bg-white rounded-xl shadow-lg overflow-hidden">
        <div class="p-6 bg-purple-600 text-white">
          <h2 class="text-2xl font-bold">My Tasks</h2>
          <p x-text="`Completed: ${stats.completed}, Remaining: ${stats.remaining}`"></p>
        </div>

        <div class="p-6 space-y-6">
          <!-- Add Todo -->
          <form @submit.prevent="addTodo" x-data="todoDashboard">
            <input
              x-model="newTodoText"
              type="text"
              placeholder="Enter new task"
              class="w-full px-4 py-2 border rounded"
            />
            <button type="submit" class="mt-2 px-4 py-2 bg-purple-600 text-white rounded">Add</button>
          </form>

          <!-- Filter Buttons -->
          <div class="flex space-x-2">
            <button @click="filter = 'all'" :class="filter === 'all' ? 'font-bold' : ''">All</button>
            <button @click="filter = 'active'" :class="filter === 'active' ? 'font-bold' : ''">Active</button>
            <button @click="filter = 'completed'" :class="filter === 'completed' ? 'font-bold' : ''">Completed</button>
          </div>

          <!-- Todo List -->
          <ul class="space-y-2">
            <template x-for="todo in filteredTodos" :key="todo._id">
              <li class="flex items-center justify-between border-b py-2">
                <div class="flex items-center">
                  <input type="checkbox" x-model="todo.completed" @change="toggleTodo(todo)" />
                  <span :class="{ 'line-through': todo.completed }" class="ml-2" x-text="todo.text"></span>
                </div>
                <button @click="deleteTodo(todo._id)" class="text-red-500">🗑</button>
              </li>
            </template>
          </ul>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/todo-dashboard.js" defer></script>
</BaseLayout>
