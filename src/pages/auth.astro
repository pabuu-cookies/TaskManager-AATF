---
import BaseLayout from "../layouts/baseLayout.astro";
---

<BaseLayout title = "TaskMate - Login">
    <div class="min-h-screen grid grid-cols-1 md:grid-cols-2 p-14" x-data="{isLogin: true}">
        <!-- left section -->
    <div class="bg-purple-600 flex items-center justify-center text-white ">
        <div  
        x-init="$el.classList.add('animate-fade-in')"
        class="max-w-md transition-opacity duration-500 ease-out"
        >
            <h1 class="text-4xl font-bold mb-6">TaskMate</h1>
            <p class="text-xl mb-8">Organize your life, one task at a time.</p>
            <div class="bg-white/20 p-6 rounded-lg backdrop-blur-sm" >
                <h2 class="text-2xl font-semibold mb-4" x-text="isLogin ? `Don't have an account?` : `Already have an account?`"></h2>
                <p class="mb-6" x-text="isLogin
                    ? 'Sign up to start tracking your tasks and boost your productivity.'
                    : 'Log in to continue managing your tasks and stay organized.'"></p>
                <button
                @click="isLogin = !isLogin"
                class="px-6 py-2 bg-white text-purple-600 rounded-full font-medium hover:bg-purple-100 transition-colors"
                x-text="isLogin ? 'Sign up' : 'Log in'"
                ></button>
            </div>
        </div>
    </div>

    <!-- right section  -->
     <div class="flex items-center justify-center bg-white ">
        <div class="w-full max-w-md space-y-6">
     <!-- login Form -->
     <div x-data="authSigninForm">
        <div x-show="isLogin" x-transition:enter="transition ease-out duration-500">
            <form @submit.prevent="handleSignin" class="space-y-4">
                <h2 class="text-2xl font-bold text-gray-900">Log In</h2>
                <input x-model="email" type="email" name="email" placeholder="Email" class=" w-full px-4 py-2 border rounded" />
                <input x-model="password" type="password" name="password" placeholder="Password" class="w-full px-4 py-2 border rounded" />
                <button type="submit" class="w-full px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700">
                Log In
                </button>
            </form>
            </div>
        </div>

        <div x-show="!isLogin" x-transition:enter="transition ease-out duration-500">
            <form @submit.prevent="handleSignup" class="space-y-4" x-data="authSignupForm">
                <h2 class ="text-2xl font-bold text-gray-800">Sign Up</h2>
                <input x-model="name" type="text" name= "name" placeholder="Name" class="w-full px-4 py-2 border rounded" />
                <input x-model = "email" type="email" name="email" placeholder="Email" class="w-full px-4 py-2 border rounded" />
                <input x-model="password" type="password" name="password" placeholder="Password" class="w-full px-4 py-2 border rounded" />
                <button type="submit" class="w-full px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700">
                Sign Up
                </button>
            </form>
        </div>
    </div>
    </div>
</div>


<style>
    [x-cloak] {display: none }
    .animate-fade-in {animation: fadeIn 0.7s forwards;}

    @keyframes fadeIn {
  0% {
    opacity: 0;
    transform: translateY(40px);
    filter: blur(4px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

</style>
<script src="/js/auth.js" defer></script>

</BaseLayout>